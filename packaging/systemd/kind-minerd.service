# kind-minerd as a system service — for a Nodo, or any box with no screen.
#
# Install the binary as /opt/kind-miner/kind-minerd, this file and
# kind-miner.slice under /etc/systemd/system, then:
#
#   sudo install -d -m 700 /etc/kind-miner
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now kind-minerd
#
# With no config it waits to be set up from the desktop app (Settings →
# Connection → Find a hub), which writes the service's own config under
# /var/lib/kind-miner. Or set it up over SSH before starting it:
#
#   sudo kind-minerd init --address 4…     # writes /etc/kind-miner/config.yaml
#   kind-minerd status                     # or: kind-minerd doctor

[Unit]
Description=kind-miner headless daemon
Documentation=https://github.com/kind-miner/kind-miner
Wants=network-online.target
After=network-online.target monerod.service tor.service

[Service]
Type=simple
ExecStart=/opt/kind-miner/kind-minerd run
Slice=kind-miner.slice
Restart=on-failure
RestartSec=30

# No account to create or clean up: systemd makes a user for each run.
DynamicUser=yes
# /var/lib/kind-miner: engines, p2pool's data, the hashrate ledger, payouts.
# kind-minerd finds it through $STATE_DIRECTORY.
StateDirectory=kind-miner
# /run/kind-miner: the status file `kind-minerd status` reads.
RuntimeDirectory=kind-miner
# A config written over SSH stays root-owned and 0600; systemd hands the
# service a private copy, which kind-minerd reads from $CREDENTIALS_DIRECTORY
# as kind-miner_config.yaml. The directory rather than the file, because a
# credential naming a missing file stops the unit starting — and a Nodo set up
# from the desktop has none. The directory must exist, even empty.
LoadCredential=kind-miner:/etc/kind-miner

# Yield on every resource, not just CPU.
IOSchedulingClass=idle
# First to go if memory runs out (xmrig raises its own score to 1000).
OOMScoreAdjust=800

# Read Nodo's /home/nodo/variables/config.json; write nothing outside the
# state and runtime directories.
ProtectHome=read-only
ProtectSystem=strict
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
CapabilityBoundingSet=
# Not MemoryDenyWriteExecute: RandomX compiles its program to machine code at
# run time, so xmrig needs writable-then-executable memory to hash at all.

[Install]
WantedBy=multi-user.target
